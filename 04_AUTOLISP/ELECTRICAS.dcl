electrica : dialog {
  label = "ELECTRICAS | Biblioteca integrada IE - IC - DACI";
  : popup_list { key = "familia"; label = "Familia"; width = 68; }
  : list_box { key = "simbolos"; label = "Seleccione un simbolo"; width = 76; height = 20; }
  : text { key = "detalle"; width = 76; }
  : text { label = "Geometria simbolica. Defina escala con EIESCALA antes de insertar."; }
  ok_cancel;
}
